# Copy to .env.local and fill in. Never commit real values.

# App
APP_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret cron-job.org sends to /api/cron/sweep
CRON_SECRET=

# Database (Neon via Vercel Storage)
DATABASE_URL=

# Google Calendar OAuth (app-level; per-user tokens live in the DB)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio, Stripe and email credentials are NOT env vars:
# each workspace enters its own on the Integrations page (stored encrypted).
